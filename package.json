{
  "name": "snow-mcp-gateway",
  "version": "0.1.0",
  "description": "Local gateway that turns ServiceNow REST APIs into MCP tools",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:apps && (node scripts/build-apps.mjs --watch & tsx watch src/index.ts)",
    "build:apps": "node scripts/build-apps.mjs",
    "build": "npm run build:apps && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps",
    "test": "vitest run",
    "test:e2e": "tsx test/e2e-host.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "~1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
