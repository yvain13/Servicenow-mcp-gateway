{
  "name": "servicenow-mcp-gateway",
  "version": "0.1.0",
  "description": "Local gateway that turns ServiceNow REST APIs into MCP tools",
  "type": "module",
  "bin": {
    "servicenow-mcp-gateway": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "public/",
    "data/store.seed.json",
    "apps/_kit/dist/*.js",
    "apps/*/dist/index.html",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "servicenow",
    "mcp",
    "model-context-protocol",
    "claude",
    "gateway",
    "mcp-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yvain13/Servicenow-mcp-gateway.git"
  },
  "homepage": "https://github.com/yvain13/Servicenow-mcp-gateway#readme",
  "bugs": {
    "url": "https://github.com/yvain13/Servicenow-mcp-gateway/issues"
  },
  "scripts": {
    "dev": "npm run build:apps && (node scripts/build-apps.mjs --watch & tsx watch src/index.ts)",
    "build:apps": "node scripts/build-apps.mjs",
    "build": "npm run build:apps && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps",
    "test": "vitest run",
    "test:e2e": "tsx test/e2e-host.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "~1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
